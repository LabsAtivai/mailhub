DATABASE_URL="postgresql://mailhub:mailhub@localhost:5433/mailhub"
REDIS_URL="redis://localhost:6380"
JWT_SECRET="<generate-a-strong-secret-at-least-32-chars>"
JWT_REFRESH_SECRET="<generate-another-strong-secret-at-least-32-chars>"
ENCRYPTION_KEY="<generate-with-openssl-rand-hex-32>"
PORT=3001
CORS_ORIGIN="http://localhost:5173"
# Opcional: sem isso, Sentry.init() nunca roda (fica um no-op)
SENTRY_DSN=

# Anexo grande via link (módulo large-attachments) — anexo direto (base64
# embutido) fica em 20MB porque o SendGrid rejeita mensagem total acima de
# 30MB; acima disso o front sobe pro MinIO e manda um link no corpo.
MINIO_ENDPOINT=mailhub-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mailhub-large-attachments
LARGE_ATTACHMENT_MAX_MB=200
LARGE_ATTACHMENT_EXPIRY_DAYS=30
# URL pública do backend, usada pra montar o link de download que vai no e-mail
PUBLIC_BASE_URL=https://mailhub.labsativa.com.br
