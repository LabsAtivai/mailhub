DATABASE_URL="postgresql://mailhub:mailhub@localhost:5433/mailhub"
REDIS_URL="redis://localhost:6380"
ENCRYPTION_KEY="<generate-with-openssl-rand-hex-32>"
# Opcional: sem isso, Sentry.init() nunca roda (fica um no-op)
SENTRY_DSN=

# ── Relatório diário de triagem (16h America/Sao_Paulo) ────────────────────
# Sem OPENAI_API_KEY ou SENDGRID_API_KEY/REPORT_EMAIL_FROM, o relatório roda
# mas fica no log de erro sem enviar (ver worker/src/report/mailer.ts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SENDGRID_API_KEY=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=labs.ativaai@gmail.com
