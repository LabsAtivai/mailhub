# Copie este arquivo para .env e preencha os valores de produção

# ── Banco de dados ────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://mailhub:<POSTGRES_PASSWORD>@mailhub-postgres:5432/mailhub

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@mailhub-redis:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Criptografia IMAP (MESMO valor no backend e no worker) ────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://seu-dominio.com
VITE_API_URL=/

# ── Envio de e-mail (opcional) ────────────────────────────────────────────────
SENDGRID_API_KEY=

# ── Resposta por IA (backend, módulo ai) ───────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Relatório diário de triagem (worker, 15h America/Sao_Paulo) ───────────────
# Reusa OPENAI_API_KEY e SENDGRID_API_KEY acima. Sem REPORT_EMAIL_FROM o
# relatório não é enviado (fica só logado).
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=labs.ativaai@gmail.com

# ── Anexo grande via link (backend + worker, módulo large-attachments) ────────
# Anexo direto (base64 embutido no e-mail) fica em 20MB porque o SendGrid
# rejeita mensagem total acima de 30MB — acima disso o front sobe pro MinIO e
# manda um link no corpo. Gerar MINIO_ROOT_USER/PASSWORD como usuário/senha
# normais (o MinIO usa como access/secret key também).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=mailhub-large-attachments
LARGE_ATTACHMENT_MAX_MB=200
LARGE_ATTACHMENT_EXPIRY_DAYS=30
# URL pública do backend, usada pra montar o link de download que vai no e-mail
PUBLIC_BASE_URL=https://mailhub.labsativa.com.br
